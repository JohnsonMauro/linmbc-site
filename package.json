  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.4",
    "tailwind-csstree": "^0.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
