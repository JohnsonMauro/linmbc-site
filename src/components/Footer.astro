---
import type { Dict } from '../i18n/dict';
import { asset } from '../lib/asset';
import { AUTHOR_URL, ISSUES_URL, REPO_URL } from '../lib/links';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-page flex-col gap-6 px-4 py-10 text-sm text-ink-faint sm:px-6 md:flex-row md:items-center">
    <div class="flex items-center gap-3">
      <img src={asset('img/logo.svg')} alt="" width="28" height="28" class="size-7" />
      <span class="font-display font-bold text-ink">LinMBC</span>
    </div>
    <p class="md:mr-auto">{dict.footer.notAffiliated}</p>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-2">
      <a href={REPO_URL} class="hover:text-ink">
        GitHub
      </a>
      <a href={ISSUES_URL} class="hover:text-ink">
        {dict.footer.issues}
      </a>
      <a href={`${REPO_URL}/blob/main/LICENSE`} class="hover:text-ink">
        {dict.footer.license}
      </a>
      <a href={AUTHOR_URL} class="hover:text-ink">
        {dict.footer.madeBy}
      </a>
    </nav>
  </div>
</footer>
