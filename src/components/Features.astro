---
import type { Dict } from '../i18n/dict';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;

// One icon per feature, in the dictionary's order (24px grid, stroked).
const ICONS = [
  // A profile per game: stacked layers.
  'M12 3 3 8l9 5 9-5-9-5zM3 13l9 5 9-5M3 17.5l9 5 9-5',
  // Four ways to click: a mouse with a looping arrow.
  'M9 3h0a5 5 0 0 1 5 5v5a5 5 0 0 1-10 0V8a5 5 0 0 1 5-5zM9 3v5M17 7a6 6 0 0 1 2 9M21 13l-2 3-3-1',
  // Any key or combo: a keyboard.
  'M3 7h18v10H3zM6.5 10h.01M10 10h.01M13.5 10h.01M17 10h.01M7 14h10',
  // Steam library: a gamepad.
  'M6 9h12a3 3 0 0 1 3 3v2a3 3 0 0 1-5.4 1.8L14.5 14h-5l-1.1 1.8A3 3 0 0 1 3 14v-2a3 3 0 0 1 3-3zM8 11v3M6.5 12.5h3M15.5 12h.01M17.5 13.5h.01',
  // Works on Wayland: a window over a stack.
  'M4 5h16v11H4zM8 20h8M12 16v4M4 9h16',
  // Every mouse, any time: a plug.
  'M9 3v5M15 3v5M7 8h10v3a5 5 0 0 1-10 0V8zM12 16v5',
];

// Focused window → active profile, as the app's status line shows it.
const SWITCHES = [
  ['steam_app_899770', 'Last Epoch'],
  ['steam_app_2694490', 'Path of Exile 2'],
  ['firefox', 'Default'],
];
---

<section
  id="features"
  class="mx-auto max-w-page px-4 py-24 sm:px-6"
  aria-labelledby="features-title"
>
  <h2 id="features-title" class="font-display text-3xl font-extrabold tracking-tight sm:text-4xl">
    {dict.features.title}
  </h2>
  <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {dict.features.items.map((item, index) => (
      <li
        class:list={[
          'group relative overflow-hidden rounded-2xl border border-line bg-surface p-7 transition-colors hover:border-blue/50',
          index === 0 &&
            'flex flex-col bg-linear-to-br from-blue-deep/35 to-surface sm:col-span-2 lg:row-span-2',
        ]}
      >
        <svg
          viewBox="0 0 24 24"
          class="size-9 rounded-lg bg-blue/12 p-1.5 text-blue transition-colors group-hover:bg-gold/15 group-hover:text-gold"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={ICONS[index]} />
        </svg>
        <h3 class="mt-5 font-display text-xl font-bold">{item.title}</h3>
        <p class="mt-2 leading-relaxed text-ink-muted">{item.body}</p>
        {index === 0 && (
          <ul class="mt-auto grid gap-2 pt-8 font-mono text-sm" aria-hidden="true">
            {SWITCHES.map(([window, profile], row) => (
              <li
                class:list={[
                  'flex items-center justify-between gap-4 rounded-lg border px-4 py-2.5',
                  row === 0
                    ? 'border-gold/40 bg-gold/10 text-gold'
                    : 'border-line bg-night/60 text-ink-muted',
                ]}
              >
                <span>{window}</span>
                <span class="text-ink-faint">→</span>
                <span>{profile}</span>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</section>
