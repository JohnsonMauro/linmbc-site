---
import type { Dict } from '../i18n/dict';
import { asset } from '../lib/asset';
import { REPO_URL } from '../lib/links';

interface Props {
  dict: Dict;
  shot: string;
}

const { dict, shot } = Astro.props;
---

<section class="hero relative overflow-clip" aria-labelledby="hero-title" data-hero>
  {/* Backdrop, under everything: CSS glow (fallback and first paint), WebGL
      tide, then the signal network. Decorative: hidden from assistive tech. */}
  <div class="hero-backdrop pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute -top-40 right-[-20%] size-[52rem] rounded-full bg-[radial-gradient(circle,--theme(--color-blue/0.22),transparent_65%)]"></div>
    <canvas class="backdrop-layer absolute inset-0 size-full" data-tide></canvas>
    <canvas class="backdrop-layer absolute inset-0 size-full" data-network></canvas>
    <div class="absolute inset-x-0 bottom-0 h-1/4 bg-linear-to-b from-transparent to-night"></div>
  </div>
  <div class="relative mx-auto grid max-w-page items-center gap-12 px-4 pt-16 pb-14 sm:px-6 lg:grid-cols-[minmax(0,4fr)_minmax(0,6fr)] lg:pt-24 lg:pb-20">
    {/* The anchor the backdrop keeps clear; the inner div carries the entrance,
        the outer one the scroll exit (two animations, two elements). */}
    <div class="hero-copy" data-backdrop-anchor>
      <div class="animate-rise">
        <p class="inline-flex items-center gap-2 rounded-full border border-gold/40 bg-gold/10 px-3 py-1 text-xs font-semibold tracking-widest text-gold uppercase">
          <span class="size-1.5 rounded-full bg-gold" aria-hidden="true"></span>
          {dict.hero.badge}
        </p>
        <h1
          id="hero-title"
          class="mt-6 font-display text-4xl leading-[1.05] font-extrabold tracking-tight text-balance sm:text-5xl lg:text-[3.4rem]"
        >
          {dict.hero.title}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-muted">{dict.hero.tagline}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href="#install"
            class="rounded-lg bg-blue px-6 py-3 font-semibold text-night shadow-lg shadow-blue/25 transition hover:-translate-y-0.5 hover:bg-gold hover:shadow-gold/25 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold active:translate-y-0"
          >
            {dict.hero.ctaInstall}
          </a>
          <a
            href={REPO_URL}
            class="flex items-center gap-2 rounded-lg border border-line px-6 py-3 font-semibold text-ink transition hover:-translate-y-0.5 hover:border-ink-faint focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold active:translate-y-0"
          >
            <svg viewBox="0 0 16 16" class="size-4" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
            {dict.hero.ctaSource}
          </a>
        </div>
        <p class="mt-6 text-sm text-ink-faint">{dict.hero.note}</p>
      </div>
    </div>

    <figure class="relative animate-rise pb-16 [animation-delay:120ms] sm:pb-24">
      <div class="overflow-hidden rounded-xl border border-line bg-surface shadow-2xl shadow-black/60 ring-1 ring-white/5">
        <img
          src={asset(`screenshots/main-${shot}.webp`)}
          alt={dict.screens.mainAlt}
          width="980"
          height="430"
          class="block h-auto w-full"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="absolute right-[-4%] bottom-0 w-[52%] overflow-hidden rounded-xl border border-line bg-surface shadow-2xl shadow-black/70 ring-1 ring-gold/20 sm:right-[-6%]">
        <img
          src={asset(`screenshots/mapping-${shot}.webp`)}
          alt={dict.screens.mappingAlt}
          width="460"
          height="394"
          class="block h-auto w-full"
          loading="eager"
        />
      </div>
      <figcaption class="mt-4 text-sm text-ink-faint sm:absolute sm:bottom-2 sm:left-0 sm:mt-0 sm:max-w-[44%]">
        {dict.screens.mappingCaption}
      </figcaption>
    </figure>
  </div>
  <div class="relative mx-auto flex max-w-page flex-wrap items-center gap-x-5 gap-y-2 px-4 pb-8 text-sm text-ink-faint sm:px-6 motion-reduce:hidden">
    <button
      type="button"
      class="flex items-center gap-2 rounded-md border border-line bg-night/70 px-3 py-1.5 text-ink-muted transition-colors hover:border-ink-faint hover:text-ink focus-visible:outline-2 focus-visible:outline-gold"
      aria-pressed="false"
      data-motion-toggle
      data-label-pause={dict.hero.pause}
      data-label-play={dict.hero.play}
    >
      <svg viewBox="0 0 16 16" class="size-3.5" fill="currentColor" aria-hidden="true">
        <path data-icon-pause d="M4 3h3v10H4zM9 3h3v10H9z"></path>
        <path data-icon-play class="hidden" d="M5 3l8 5-8 5z"></path>
      </svg>
      <span data-motion-label>{dict.hero.pause}</span>
    </button>
    <p class="hidden text-ink-muted pointer-fine:block">{dict.hero.eggTip}</p>
    <p
      class="rounded-md border border-gold/40 bg-gold/10 px-3 py-1.5 font-mono text-gold opacity-0 transition-opacity data-shown:opacity-100 [font-variant-ligatures:none]"
      aria-live="polite"
      data-hero-toast
      data-rear={dict.hero.eggRear}
      data-front={dict.hero.eggFront}
      data-front-off={dict.hero.eggFrontOff}
      data-hint={dict.hero.eggHint}
    ></p>
  </div>
</section>

<script>
  import { mountHeroInput } from '../backdrop/heroInput';
  import { isPaused, setPaused } from '../backdrop/motion';
  import { mountSignalNetwork } from '../backdrop/signalNetwork';
  import { mountTide } from '../backdrop/tideBackdrop';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const anchor = document.querySelector<HTMLElement>('[data-backdrop-anchor]');
  const tide = document.querySelector<HTMLCanvasElement>('[data-tide]');
  const network = document.querySelector<HTMLCanvasElement>('[data-network]');
  const toast = document.querySelector<HTMLElement>('[data-hero-toast]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');

  if (hero && anchor && tide) mountTide(tide, anchor);

  if (toggle) {
    toggle.addEventListener('click', () => {
      setPaused(!isPaused());
      const paused = isPaused();
      toggle.setAttribute('aria-pressed', String(paused));
      const label = toggle.querySelector('[data-motion-label]');
      if (label)
        label.textContent = (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? '';
      toggle.querySelector('[data-icon-pause]')?.classList.toggle('hidden', paused);
      toggle.querySelector('[data-icon-play]')?.classList.toggle('hidden', !paused);
    });
  }

  if (hero && anchor && network && toast) {
    // Key labels are drawn once into sprites: wait for their font (or give up
    // after a moment and use the fallback face).
    const font = document.fonts.load('600 16px "JetBrains Mono"').catch(() => undefined);
    const timeout = new Promise((resolve) => setTimeout(resolve, 1500));
    void Promise.race([font, timeout]).then(() => {
      const signals = mountSignalNetwork(network, anchor);
      const { rear = '', front = '', frontOff = '', hint } = toast.dataset;
      mountHeroInput(hero, signals, toast, { rear, front, frontOff });
      // Deliberate console output: the easter egg's hint, for whoever opens DevTools.
      if (hint) console.info(hint);
    });
  }
</script>
