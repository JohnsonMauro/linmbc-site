---
import '../styles/global.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { LOCALES, DEFAULT_LOCALE, HREFLANG_TAGS, OG_LOCALES, type Locale } from '../i18n/config';
import { asset } from '../lib/asset';
import GoatCounter from '../components/GoatCounter.astro';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  keywords: string;
}

const { lang, title, description, keywords } = Astro.props;

const canonical = getAbsoluteLocaleUrl(lang, '');
const defaultUrl = getAbsoluteLocaleUrl(DEFAULT_LOCALE, '');
// Link-card image, one per locale (scripts/gen-og-images.mjs); absolute URL.
const ogImage = new URL(asset(`img/og-${lang}.png`), Astro.site).href;
---

<!doctype html>
<html lang={HREFLANG_TAGS[lang]} class="bg-night">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="theme-color" content="#070b14" />
    <meta name="color-scheme" content="dark" />

    <link rel="canonical" href={canonical} />
    {LOCALES.map((loc) => (
      <link rel="alternate" hreflang={HREFLANG_TAGS[loc]} href={getAbsoluteLocaleUrl(loc, '')} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={asset('img/favicon-32x32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={asset('img/apple-touch-icon.png')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Manrope:wght@600;700;800&display=swap"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LinMBC" />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    {LOCALES.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALES[l]} />
    ))}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <GoatCounter />
  </head>
  <body class="bg-night font-sans text-ink antialiased [word-break:auto-phrase]">
    <slot />
  </body>
</html>
